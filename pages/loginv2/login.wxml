<!-- 装饰性背景元素 -->
<view class="bg-decoration bg-decoration-1"></view>
<view class="bg-decoration bg-decoration-2"></view>
<view class="bg-decoration bg-decoration-3"></view>

<!-- 登录容器 -->
<view class="login-container">
  <view class="logo-section">
    <view class="logo">深</view>
    <text class="title">欢迎使用深圳技术大学</text>
    <text class="title-sub">校园小程序</text>
  </view>

  <!-- 登录表单 -->
  <form bindsubmit="formSubmit">
    <view class="form-group">
      <label class="form-label">学号</label>
      <view class="input-wrapper">
        <input 
          type="text" 
          placeholder="请输入学号"
          value="{{studentId}}"
          bindinput="onStudentIdInput"
          required
        />
      </view>
    </view>

    <view class="form-group">
      <label class="form-label">密码</label>
      <view class="input-wrapper">
        <input 
          type="password" 
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
          required
        />
      </view>
    </view>

    <view class="remember-forgot">
      <view class="remember-me">
        <view class="checkbox-wrapper">
          <checkbox 
            checked="{{remember}}"
            bindchange="onRememberChange"
          />
          <view class="checkbox-custom {{remember ? 'checked' : ''}}"></view>
        </view>
        <label class="remember-label">记忆账号</label>
      </view>
      <text class="forgot-password" bindtap="forgotPassword">忘记密码？</text>
    </view>

    <button form-type="submit" class="login-button">登录</button>
  </form>
</view>
