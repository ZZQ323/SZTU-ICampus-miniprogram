/* pages/schedule/index.wxss */

.schedule-container {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f5f5f5;
}

.selector-container{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif ;
}

.week-selector1 {
    background: white;
    padding: 20rpx;
    margin: 40rpx;
    border-bottom: 3rpx solid black;
    border-right: 3rpx solid black;
    /* border: 3rpx solid black; */
    font-weight: 600;
    border-radius: 20rpx;
    background-color: rgb(197, 241, 255);
}

.week-selector2 {
    background: white;
    padding: 20rpx;
    margin: 40rpx;
    border-bottom: 3rpx solid black;
    border-right: 3rpx solid black;
    /* border: 3rpx solid black; */
    font-weight: 600;
    border-radius: 20rpx;
    background-color: rgb(197, 241, 255);
}

.picker {
    text-align: center;
    font-size: 32rpx;
    font-weight: bold;
}

.schedule-grid {
    flex: 1;
    overflow: auto;
}

.grid-header {
    display: flex;
    position: sticky;
    top: 0;
    background: white;
    z-index: 10;
    border-bottom: 2px solid #ddd;
}

.time-header {
    width: 120rpx;
    padding: 20rpx;
    text-align: center;
    font-weight: bold;
    font-size: 24rpx;
}

.day-header {
    flex: 1;
    min-width: 140rpx;
    padding: 20rpx;
    text-align: center;
    font-weight: bold;
    font-size: 28rpx;
}

.grid-body {
    display: flex;
    flex-direction: column;
}

.time-row {
    display: flex;
    min-height: 200rpx;
    border-bottom: 1px solid #eee;
}

.time-cell {
    width: 120rpx;
    padding: 10rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #fafafa;
    border-right: 1px solid #eee;
}

.time-label {
    font-size: 24rpx;
    color: #333;
    margin-bottom: 8rpx;
}

.time-range {
    font-size: 20rpx;
    color: #999;
}

.course-cell {
    flex: 1;
    min-width: 140rpx;
    padding: 8rpx;
    border-right: 1px solid #eee;
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.course-item {
    padding: 12rpx;
    border-radius: 8rpx;
    font-size: 24rpx;
    overflow: hidden;
}

.course-name {
    font-weight: bold;
    display: block;
    margin-bottom: 4rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.course-location {
    font-size: 20rpx;
    opacity: 0.8;
    display: block;
}

/* 课程颜色 */
.color1 {
    background: #E3F2FD;
    color: #1976D2;
}

.color2 {
    background: #F3E5F5;
    color: #7B1FA2;
}

.color3 {
    background: #E8F5E9;
    color: #388E3C;
}

.color4 {
    background: #FFF3E0;
    color: #F57C00;
}

.color5 {
    background: #FCE4EC;
    color: #C2185B;
}

/* 详情弹窗 */
.detail-modal {
    background: white;
    padding: 40rpx;
    border-radius: 20rpx;
    max-width: 600rpx;
}

.detail-title {
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 30rpx;
    text-align: center;
}

.detail-item {
    margin-bottom: 20rpx;
    font-size: 28rpx;
}

.detail-item .label {
    font-weight: bold;
    color: #666;
}