/* pages/person/login/index.wxss */

.container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5vw;
    background-color: white;
}



.custom-tabs {
    margin: 32rpx 0;
}


.tabs-viewdeck {
    border-radius: 30rpx;
    padding: 10rpx;
    border: lightblue 10rpx solid;
}

.button {
    margin: 5vh 10vw;
}

.suffix {
    display: flex;
    align-items: center;
}

.suffix--line {
    width: 1px;
    height: 24px;
    background-color: var(--td-component-stroke, #f3f3f3);
    margin-right: 16px;
}

.image {
    width: 72px;
    height: 36px;
    display: block;
    margin-top: -6px;
    margin-bottom: -6px;
}

.tips {
    text-align: right !important;
}

.verify {
    color: var(--td-brand-color, #0052d9);
    font-size: 32rpx;
}