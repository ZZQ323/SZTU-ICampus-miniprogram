{
  "easycom": {
    "custom": {
      "^t-(.*)": "tdesign-uniapp/$1/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/home",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/common/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/notice/notice",
      "style": {
        "navigationBarTitleText": "信息流",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/notice/detail",
      "style": {
        "navigationBarTitleText": "详情",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/notice/subscribe",
      "style": {
        "navigationBarTitleText": "管理订阅"
      }
    },
    {
      "path": "pages/schedule/schedule",
      "style": {
        "navigationBarTitleText": "课表查询"
      }
    },
    {
      "path": "pages/common/webview/webview",
      "style": {
        "navigationBarTitleText": ""
      }
    },
    {
      "path": "pages/calendar/calendar",
      "style": {
        "navigationBarTitleText": "活动日历"
      }
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#0052d9",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "static/tab/normal/home.png",
        "selectedIconPath": "static/tab/active/home.png"
      },
      {
        "pagePath": "pages/schedule/schedule",
        "text": "课表",
        "iconPath": "static/tab/normal/calendar.png",
        "selectedIconPath": "static/tab/active/calendar.png"
      },
      {
        "pagePath": "pages/notice/notice",
        "text": "信息流",
        "iconPath": "static/tab/normal/notice.png",
        "selectedIconPath": "static/tab/active/notice.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "iCampus",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F8F8"
  }
}