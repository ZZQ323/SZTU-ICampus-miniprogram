/* 页面根容器（唯一定义，消除重复） */
page {
	font-family: 'PingFang SC', 'Noto Sans SC', sans-serif;
	min-height: 100vh;
	/* background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #f093fb 50%, #4facfe 75%, #00f2fe 100%); */
	/* background: linear-gradient(135deg,
			#667eea 0%,
			#764ba2 15%,
			#f093fb 30%,
			#ff6ec4 45%,
			#ff8a00 60%,
      #4facfe 75%,
      #184cad 85%,
			#00f2fe 90%,
			#00ff7f 100%);
  animation: gradientFlow 15s ease infinite; */
	/* background: linear-gradient(
        135deg,
        #ff0000 0%,    
        #ff7f00 14%,   
        #ffff00 28%,   
        #00ff00 42%,   
        #0000ff 56%,   
        #4b0082 70%,   
        #9400d3 84%,   
        #ff0000 100%   
    );
    animation: gradientFlow 10s ease infinite; */
	/* background-size: 200% 200%; */
	/* background: conic-gradient(
        from 0deg,
        #ff0000 0deg,     
        #ff7f00 51.4deg,  
        #ffff00 102.8deg, 
        #00ff00 154.2deg, 
        #0000ff 205.6deg, 
        #4b0082 257deg,   
        #9400d3 308.4deg, 
        #ff0000 360deg    
    );
  animation: rainbowRotate 3s linear infinite; */

	/* background-size: 400% 400%; */
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 20rpx 20rpx;
	/* 进一步缩小左右内边距 */
	position: relative;
	box-sizing: border-box;
	/* 关键：padding不占额外宽度 */
}

page::before {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	width: 400vw;
	height: 400vh;
	background: conic-gradient(from 0deg,
			rgba(255, 0, 0, 0.65) 0deg,
			rgba(255, 127, 0, 0.65) 51.4deg,
			rgba(255, 255, 0, 0.65) 102.8deg,
			rgba(0, 255, 0, 0.65) 154.2deg,
			rgba(7, 7, 255, 0.65) 205.6deg,
			rgba(75, 0, 130, 0.65) 257deg,
			rgba(148, 0, 211, 0.65) 308.4deg,
			rgba(255, 0, 0, 0.65) 360deg);
	transform-origin: center center;
	transform: translate(-50%, -50%);
	animation: rainbowRotate 8s linear infinite;
	z-index: -1;
}

.disappear {
	display: none;
}

/* 渐变动画 */
@keyframes gradientFlow {
	0% {
		background-position: 0% 50%;
	}

	50% {
		background-position: 100% 50%;
	}

	100% {
		background-position: 0% 50%;
	}
}

@keyframes rainbowRotate {
	from {
		transform: translate(-50%, -50%) rotate(0deg);
	}

	to {
		transform: translate(-50%, -50%) rotate(360deg);
	}
}

/* 装饰性背景元素：缩小尺寸，避免溢出屏幕 */
.bg-decoration {
	position: absolute;
	border-radius: 50%;
	opacity: 0.1;
	animation: float 20s ease-in-out infinite;
}

.bg-decoration-1 {
	width: 400rpx;
	/* 原600rpx，大幅缩小 */
	height: 400rpx;
	background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 70%);
	top: -150rpx;
	left: -150rpx;
	animation-delay: 0s;
}

.bg-decoration-2 {
	width: 300rpx;
	/* 原400rpx */
	height: 300rpx;
	background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 70%);
	bottom: -80rpx;
	right: -80rpx;
	animation-delay: 5s;
}

.bg-decoration-3 {
	width: 200rpx;
	/* 原300rpx */
	height: 200rpx;
	background: radial-gradient(circle, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 70%);
	top: 50%;
	right: 5%;
	animation-delay: 10s;
}

@keyframes float {

	0%,
	100% {
		transform: translate(0, 0) scale(1);
	}

	33% {
		transform: translate(40rpx, -40rpx) scale(1.1);
	}

	/* 缩小位移 */
	66% {
		transform: translate(-30rpx, 30rpx) scale(0.9);
	}
}

/* 登录容器：适配iPhone 12/13 Pro（780rpx宽度）的核心调整 */
.login-container {
	background: rgba(255, 255, 255, 0.95);
	backdrop-filter: blur(40rpx);
	border-radius: 48rpx;
	padding: 50rpx 30rpx;
	/* 进一步缩小内边距 */
	width: 90%;
	/* 基于屏幕宽度的百分比 */
	max-width: 650rpx;
	/* 适配780rpx屏幕，留足边距 */
	box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.12),
		0 0 0 2rpx rgba(255, 255, 255, 0.3) inset;
	animation: slideUp 0.6s ease-out;
	position: relative;
	box-sizing: border-box;
	/* 关键：padding/border不占额外宽度 */
}

@keyframes slideUp {
	from {
		opacity: 0;
		transform: translateY(60rpx);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}
}

/* 顶部光晕：适配缩小后的容器 */
.login-container::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	height: 250rpx;
	/* 原300rpx，进一步缩小 */
	background: linear-gradient(180deg, rgba(102, 126, 234, 0.08) 0%, rgba(102, 126, 234, 0) 100%);
	border-radius: 48rpx 48rpx 0 0;
	pointer-events: none;
}

/* 校徽区域 */
.logo-section {
	text-align: center;
	margin-bottom: 60rpx;
	/* 原80rpx */
	animation: fadeIn 0.8s ease-out 0.2s both;
}

@keyframes fadeIn {
	from {
		opacity: 0;
		transform: translateY(-20rpx);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}
}

/* logo：适配iPhone 12/13 Pro的尺寸 */
.logo {
	width: 130rpx;
	/* 原100rpx */
	height: 130rpx;
	background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
	border-radius: 28rpx;
	/* 原32rpx */
	margin: 0 auto 25rpx;
	/* 原30rpx */
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 50rpx;
	/* 原56rpx */
	color: white;
	font-weight: 700;
	box-shadow: 0 10rpx 30rpx rgba(30, 91, 206, 0.3);
	/* transform-origin: center center; */
	transform: rotate(-12deg);
	transition: transform 0.3s ease;
}

.logo:active {
	transform: rotate(15deg) scale(1.1);
	/* animation: littleRotate 3s linear infinite; */
}

@keyframes littleRotate {
	0% {
		transform: rotate(10deg) scale(1.05);
		background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
	}

	25% {
		transform: rotate(20deg) scale(1.05);
		background: linear-gradient(135deg, #4a90e2 0%, #1e5bce 100%);
	}

	50% {
		transform: rotate(40deg) scale(1.05);
		background: linear-gradient(135deg, #4a90e2 0%, #1e5bce 100%);
	}

	75% {
		transform: rotate(80deg) scale(1.05);
		background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
	}

	100% {
		transform: rotate(100deg) scale(1.05);
		background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
	}
}

/* 标题文字：进一步缩小 */
.title,
.title-sub {
	font-size: 34rpx;
	/* 原36rpx */
	font-weight: 600;
	color: #1a1a2e;
	line-height: 1.3;
	/* 缩小行高 */
	letter-spacing: 0.4rpx;
	display: block;
}

.title-sub {
	margin-top: 5rpx;
}

/* 表单组 */
.form-group {
	margin-bottom: 30rpx;
	/* 原36rpx */
	animation: fadeIn 0.8s ease-out 0.4s both;
}

.form-group:nth-child(2) {
	animation-delay: 0.5s;
}

/* 表单标签 */
.form-label {
	display: block;
	margin-bottom: 14rpx;
	/* 原16rpx */
	font-size: 24rpx;
	/* 原26rpx */
	font-weight: 500;
	color: #1a1a2e;
	letter-spacing: 0.3rpx;
}

.input-wrapper {
	display: flex;
}

.input-wrapper button {
	padding: 10px;
	margin-left: 20px;
}

/* 输入框：核心缩小，适配小屏 */
input {
	width: 100%;
	padding: 10px;
	height: 50px;
	border: 3rpx solid transparent;
	/* 原4rpx，缩小边框 */
	background-color: white;
	background: linear-gradient(white, white) padding-box,
		linear-gradient(135deg, #e5e7eb 0%, #f3f4f6 100%) border-box;
	border-radius: 28rpx;
	/* 原32rpx */
	font-size: 26rpx;
	/* 原28rpx */
	color: #1a1a2e;
	outline: none;
	transition: all 0.3s ease;
	box-sizing: border-box;
}

input:focus {
	border: 3rpx solid transparent;
	background: linear-gradient(white, white) padding-box,
		linear-gradient(135deg, #1e5bce 0%, #00d4ff 100%) border-box;
	box-shadow: 0 12rpx 36rpx rgba(30, 91, 206, 0.15);
	transform: translateY(-3rpx);
}

input::placeholder {
	color: #9ca3af;
	font-size: 26rpx;
}

/* 记住密码 & 忘记密码 */
.remember-forgot {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 40rpx;
	/* 原48rpx */
	animation: fadeIn 0.8s ease-out 0.6s both;
}

.remember-me {
	display: flex;
	align-items: center;
	gap: 20rpx;
	/* user-select: none; */
}

.checkbox-wrapper {
	position: relative;
	width: 40rpx;
	height: 40rpx;
}

.checkbox-custom {
	position: absolute;
	top: 0;
	left: 0;
	width: 40rpx;
	height: 40rpx;
	border: 4rpx solid #d1d5db;
	border-radius: 12rpx;
	background: white;
	transition: all 0.3s ease;
}

.checkbox-custom.checked {
	background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
	border-color: #1e5bce;
}

.checkbox-custom::after {
	content: '';
	position: absolute;
	display: none;
	left: 12rpx;
	top: 4rpx;
	width: 10rpx;
	height: 20rpx;
	border: solid white;
	border-width: 0 4rpx 4rpx 0;
	transform: rotate(45deg);
}

.checkbox-custom.checked::after {
	display: block;
}

.remember-label {
	font-size: 28rpx;
	color: #6b7280;
}

.forgot-password {
	color: #1e5bce;
	font-size: 26rpx;
	font-weight: 500;
	position: relative;
	padding-bottom: 3rpx;
	/* 原4rpx */
}

.forgot-password::after {
	content: '';
	position: absolute;
	bottom: 0;
	left: 0;
	width: 0;
	height: 3rpx;
	/* 原4rpx */
	background: linear-gradient(90deg, #1e5bce 0%, #00d4ff 100%);
	transition: width 0.3s ease;
}

.forgot-password:active::after {
	width: 100%;
}

.forgot-password:active {
	color: #4a90e2;
}

/* 登录按钮 */
.login-button {
	width: 100%;
	padding: 24rpx;
	/* 原28rpx */
	background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 50%, #00d4ff 100%);
	background-size: 200% 100%;
	background-position: 0% 0%;
	color: white;
	border: none;
	border-radius: 28rpx;
	/* 原32rpx */
	font-size: 28rpx;
	/* 原30rpx */
	font-weight: 600;
	box-shadow: 0 10rpx 30rpx rgba(30, 91, 206, 0.2);
	letter-spacing: 0.8rpx;
	animation: fadeIn 0.8s ease-out 0.7s both;
	position: relative;
	box-sizing: border-box;
}

.login-button::before {
	content: '';
	position: absolute;
	top: 0;
	left: -100%;
	width: 100%;
	height: 100%;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
	transition: left 0.5s ease;
}

.login-button:active {
	background-position: 100% 0%;
	box-shadow: 0 18rpx 48rpx rgba(30, 91, 206, 0.2);
	transform: translateY(-3rpx);
}

.login-button:active::before {
	left: 100%;
}

/* 专门适配iPhone 12/13 Pro（780rpx宽度）的媒体查询 */
@media (max-width: 780rpx) {
	.login-container {
		max-width: 92%;
		/* 进一步贴合屏幕 */
		padding: 40rpx 25rpx;
	}

	.logo {
		width: 80rpx;
		height: 80rpx;
		font-size: 30rpx;
	}

	.title,
	.title-sub {
		font-size: 32rpx;
	}

	input {
		padding: 18rpx 24rpx;
	}

	.login-button {
		padding: 22rpx;
	}
}

.hint {
	display: flex;
	position: absolute;
	width: 70%;
	font-size: 16px;
	left: 5%;
	border-radius: 6px;
	border: 2px white double;
	flex-direction: column;
	top: 50%;
	color: white;
	background: linear-gradient(90deg, #184cad, #85a8e9);
	z-index: 99;
	/* padding: 10px 0 10px 10px; */
}