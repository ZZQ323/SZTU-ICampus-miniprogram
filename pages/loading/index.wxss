/* pages/loading/index.wxss */

.loading-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
    padding: 0 48rpx;
    box-sizing: border-box;
}

/* =====================================================
    头部区域
   ===================================================== */
.header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 120rpx;
    padding-bottom: 60rpx;
}

.logo-section {
    text-align: center;
    margin-bottom: 60rpx;
    /* 原80rpx */
    animation: fadeIn 0.8s ease-out 0.2s both;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(-20rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* logo：适配iPhone 12/13 Pro的尺寸 */
.logo {
    width: 130rpx;
    /* 原100rpx */
    height: 130rpx;
    background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
    border-radius: 28rpx;
    /* 原32rpx */
    margin: 0 auto 25rpx;
    /* 原30rpx */
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 50rpx;
    /* 原56rpx */
    color: white;
    font-weight: 700;
    box-shadow: 0 10rpx 30rpx rgba(30, 91, 206, 0.3);
    /* transform-origin: center center; */
    transform: rotate(-12deg);
    transition: transform 0.3s ease;
}

.logo:active {
    transform: rotate(15deg) scale(1.1);
    /* animation: littleRotate 3s linear infinite; */
}

@keyframes littleRotate {
    0% {
        transform: rotate(10deg) scale(1.05);
        background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
    }

    25% {
        transform: rotate(20deg) scale(1.05);
        background: linear-gradient(135deg, #4a90e2 0%, #1e5bce 100%);
    }

    50% {
        transform: rotate(40deg) scale(1.05);
        background: linear-gradient(135deg, #4a90e2 0%, #1e5bce 100%);
    }

    75% {
        transform: rotate(80deg) scale(1.05);
        background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
    }

    100% {
        transform: rotate(100deg) scale(1.05);
        background: linear-gradient(135deg, #1e5bce 0%, #4a90e2 100%);
    }
}

/* 标题文字：进一步缩小 */
.title,
.title-sub {
    font-size: 34rpx;
    /* 原36rpx */
    font-weight: 600;
    color: #1a1a2e;
    line-height: 1.3;
    /* 缩小行高 */
    letter-spacing: 0.4rpx;
    display: block;
}

.title-sub {
    margin-top: 5rpx;
}

/* =====================================================
   步骤条区域
   ===================================================== */
.steps-container {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 48rpx 32rpx;
    box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
    margin-bottom: 48rpx;
}

/* TDesign Steps 组件样式覆盖 */
.steps-container .t-steps {
    --td-step-item-finish-icon-color: #07c160;
    --td-step-item-process-icon-color: #0052d9;
    --td-step-item-error-icon-color: #e34d59;
}

/* =====================================================
   状态区域
   ===================================================== */
.status-section {
    text-align: center;
    padding: 24rpx 0;
}

.status-text {
    font-size: 30rpx;
    color: #666666;
    display: block;
    margin-bottom: 24rpx;
}

/* 重试信息 */
.retry-info {
    margin-top: 16rpx;
}

.retry-text {
    font-size: 26rpx;
    color: #999999;
    display: block;
    margin-bottom: 16rpx;
}

.retry-progress {
    width: 400rpx;
    height: 8rpx;
    background: #eeeeee;
    border-radius: 4rpx;
    margin: 0 auto;
    overflow: hidden;
}

.retry-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #0052d9, #4787f0);
    border-radius: 4rpx;
    transition: width 0.3s ease;
}

/* =====================================================
   底部区域
   ===================================================== */
.footer {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-bottom: 120rpx;
}

/* 重试按钮 */
.retry-btn {
    width: 320rpx;
    height: 88rpx;
    line-height: 88rpx;
    background: #0052d9;
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 44rpx;
    border: none;
}

.retry-btn::after {
    border: none;
}

.retry-btn:active {
    background: #003cab;
}

/* 加载动画 */
.loading-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
}

.dot {
    width: 16rpx;
    height: 16rpx;
    background: #0052d9;
    border-radius: 50%;
    animation: bounce 1.4s ease-in-out infinite both;
}

.dot1 {
    animation-delay: -0.32s;
}

.dot2 {
    animation-delay: -0.16s;
}

.dot3 {
    animation-delay: 0s;
}

@keyframes bounce {

    0%,
    80%,
    100% {
        transform: scale(0.6);
        opacity: 0.5;
    }

    40% {
        transform: scale(1);
        opacity: 1;
    }
}

/* 完成提示 */
.complete-hint {
    font-size: 28rpx;
    color: #07c160;
}

/* =====================================================
   错误状态样式
   ===================================================== */
.loading-page[data-status="error"] .status-text {
    color: #e34d59;
}

/* =====================================================
   暗黑模式适配（可选）
   ===================================================== */
@media (prefers-color-scheme: dark) {
    .loading-page {
        background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
    }

    .title {
        color: #ffffff;
    }

    .steps-container {
        background: #2a2a2a;
        box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.3);
    }

    .status-text {
        color: #aaaaaa;
    }

    .retry-text {
        color: #888888;
    }

    .retry-progress {
        background: #3a3a3a;
    }
}