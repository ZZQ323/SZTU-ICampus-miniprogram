<!--pages/person/loading/index.wxml-->
<view class="container">
    <!-- 正常加载状态 -->
    <view wx:if="{{!isError}}" class="loading-content">
        <view class="loading-title">请稍后，小程序正在加载~</view>
        
        <!-- 进度条 -->
        <view class="progress-wrapper">
            <t-progress 
                theme="plump" 
                percentage="{{(curstep / 4) * 100}}" 
                color="#07c160"
            />
        </view>
        
        <!-- 步骤指示器 -->
        <wxs module="_">
            module.exports.getText = function(curstep, index) { 
                if (index < curstep) return '已完成'; 
                if (index === curstep) return '进行中...'; 
                return '等待中'; 
            };
            module.exports.getIcon = function(curstep, index) {
                if (index < curstep) return 'check';
                if (index === curstep) return 'loading';
                return 'time';
            };
        </wxs>
        
        <view class="steps-container">
            <t-steps 
                layout="vertical" 
                current="{{curstep}}" 
                bind:change="onFirstChange"
            >
                <t-step-item 
                    wx:for="{{_stateConstant}}" 
                    wx:key="index" 
                    title="{{item}}" 
                    content="{{_.getText(curstep, index)}}"
                />
            </t-steps>
        </view>
    </view>
    
    <!-- 错误状态 -->
    <view wx:else class="error-content">
        <view class="error-icon">
            <t-icon name="close-circle" size="80" color="#fa5151" />
        </view>
        <view class="error-title">加载失败</view>
        <view class="error-message">{{errorMessage}}</view>
        <view class="error-actions">
            <t-button 
                theme="primary" 
                size="large" 
                block 
                bind:tap="onRetry"
            >
                重试
            </t-button>
        </view>
    </view>
</view>
