/* pages/common/loading/index.wxss */

.loading-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* ========== 加载状态 ========== */

.loading-content {
  width: 100%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: fadeInUp 0.4s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.loading-title {
  text-align: center;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.title-emoji {
  font-size: 44rpx;
}

.status-text {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* ========== 进度条 ========== */

.progress-wrapper {
  margin-bottom: 50rpx;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* ========== 步骤列表 ========== */

.steps-container {
  margin-bottom: 40rpx;
}

.step-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.step-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  transition: all 0.3s ease;
}

/* 等待状态 */
.step-item .icon-waiting {
  background: #f5f5f5;
  color: #999;
}

/* 进行中状态 */
.step-item.step-active .icon-waiting {
  background: #fff3e0;
  color: #ff9800;
}

.icon-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 完成状态 */
.step-item.step-completed .icon-completed {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.step-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.step-item.step-active .step-title {
  color: #667eea;
  font-weight: 600;
}

.step-status {
  font-size: 22rpx;
  color: #999;
}

.step-item.step-active .step-status {
  color: #667eea;
}

.step-item.step-completed .step-status {
  color: #4caf50;
}

/* 连接线 */
.step-line {
  position: absolute;
  left: 24rpx;
  top: 68rpx;
  width: 2rpx;
  height: 100%;
  background: #e0e0e0;
  transition: background 0.3s ease;
}

.step-item.step-completed .step-line {
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

/* ========== 加载提示 ========== */

.loading-tip {
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* ========== 错误状态 ========== */

.error-content {
  width: 100%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  text-align: center;
}

.error-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.error-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.error-message {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.retry-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.retry-button:active {
  opacity: 0.8;
}
