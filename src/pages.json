{
  "easycom": {
    "custom": {
      "^t-(.*)": "tdesign-uniapp/$1/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/common/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/notice/index",
      "style": {
        "navigationBarTitleText": "公告通知"
      }
    },
    {
      "path": "pages/schedule/index",
      "style": {
        "navigationBarTitleText": "课表查询"
      }
    },
    {
      "path": "pages/calendar/index",
      "style": {
        "navigationBarTitleText": "活动日历"
      }
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#0052d9",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tab/normal/home.png",
        "selectedIconPath": "static/tab/active/home.png"
      },
      {
        "pagePath": "pages/schedule/index",
        "text": "课表",
        "iconPath": "static/tab/normal/calendar.png",
        "selectedIconPath": "static/tab/active/calendar.png"
      },
      {
        "pagePath": "pages/notice/index",
        "text": "公告",
        "iconPath": "static/tab/normal/notice.png",
        "selectedIconPath": "static/tab/active/notice.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "iCampus",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F8F8"
  }
}