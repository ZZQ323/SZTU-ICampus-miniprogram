/* pages/common/error/index.wxss */

.error-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* ========== 错误内容 ========== */

.error-content {
  width: 100%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: shakeIn 0.5s ease-out;
}

@keyframes shakeIn {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* ========== 错误图标 ========== */

.error-icon-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 40rpx;
}

.error-icon {
  position: relative;
  z-index: 2;
  font-size: 120rpx;
  text-align: center;
  animation: bounce 1s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.error-icon-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx;
  height: 140rpx;
  background: rgba(245, 87, 108, 0.1);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.5;
  }
}

/* ========== 文本内容 ========== */

.error-title {
  text-align: center;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.error-message {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

/* ========== 重试状态 ========== */

.retry-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #fff3e0;
  border-radius: 12rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #ff9800;
  border-radius: 50%;
  animation: dotBounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.retry-text {
  font-size: 26rpx;
  color: #ff9800;
  font-weight: 500;
}

/* ========== 重试次数提示 ========== */

.retry-count-tip {
  text-align: center;
  margin-bottom: 20rpx;
}

.retry-count-text {
  font-size: 24rpx;
  color: #999;
}

/* ========== 按钮组 ========== */

.button-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-button {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  transition: all 0.3s ease;
}

.primary-button {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(245, 87, 108, 0.4);
}

.primary-button:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.button-disabled {
  opacity: 0.6;
  transform: none !important;
}

.secondary-button {
  background: white;
  color: #f5576c;
  border: 2rpx solid #f5576c;
}

.secondary-button:active {
  background: #fff5f7;
}

/* ========== 错误详情 ========== */

.error-detail-section {
  margin-bottom: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 30rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  cursor: pointer;
}

.detail-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.detail-arrow {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.3s ease;
}

.arrow-up {
  transform: rotate(180deg);
}

.detail-content {
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}

.detail-hide {
  max-height: 0;
  padding: 0;
}

.detail-show {
  max-height: 500rpx;
  padding: 20rpx;
}

.detail-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  word-break: break-all;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.detail-actions {
  display: flex;
  justify-content: flex-end;
}

.copy-button {
  background: #f5576c;
  color: white;
  border: none;
  font-size: 24rpx;
}

/* ========== 帮助提示 ========== */

.help-tip {
  text-align: center;
  padding: 20rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
  border: 1rpx solid #e6f2ff;
}

.help-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}
