<view class="bg-decoration bg-decoration-1"></view><view class="bg-decoration bg-decoration-2"></view><view class="bg-decoration bg-decoration-3"></view><view class="login-container"><view class="logo-section"><view class="logo">SZTU</view><text class="title">欢迎使用深圳技术大学</text><text class="title-sub">校园小程序</text></view><cover-view class="{{isInputing?'hint':'disappear'}}"><cover-view class="hint-item" wx:for="{{filterUsrIds}}" wx:key="index" data-value="{{item}}" bindtap="selectHint">{{a}}</cover-view></cover-view><form bindsubmit="formSubmit" class="form-base"><view class="form-group"><label class="form-label" focus="{{true}}">学号</label><view class="input-wrapper"><input type="text" placeholder="请输入学号" value="{{userInfo.userId}}" bindinput="onUsrIdInput" bindfocus="onUsrIdFocus" bindblur="onUsrIdBlur" required/></view></view><view class="form-group"><label class="form-label">验证码</label><view class="input-wrapper"><input type="number" placeholder="请输入验证码" value="{{userInfo.code}}" bindinput="onCodeInput" required/><button type="primary" bind:tap="onSendSmsCode" disabled="{{isLogining}}"><block wx:if="{{c}}" u-s="{{['d']}}" u-p="{{c}}"> 重新发送({{b}}s) </block><block wx:if="{{e}}" u-s="{{['d']}}" u-p="{{e}}">{{d}}</block></button></view></view><view class="remember-forgot"><view class="remember-me"><checkbox-group bindchange="onRememberChange"><checkbox value="remAc"/><label class="remember-label">记忆账号</label></checkbox-group></view><text class="forgot-password" bindtap="forgotPassword">忘记密码？</text></view><button form-type="submit" class="login-button" bindtap="onTapSubmit" loading="{{isLogining}}">登录</button></form></view><view class="login-container disappear"><view class="logo-section"><view class="logo">SZTU</view><text class="title">欢迎使用深圳技术大学</text><text class="title-sub">校园小程序</text></view><view class="form-group"><label class="form-label">二次验证码</label><view class="input-wrapper"><input type="number" placeholder="请输入二次验证码" value="{{}}" bindinput="" required/><image src="{{''}}" mode="scaleToFill"/></view></view></view>