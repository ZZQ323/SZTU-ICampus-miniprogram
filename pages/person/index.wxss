/* pages/person/index.wxss */

page {
    display: flex;
    flex-direction: column;
}

/* page.wxss */
.user-info {
    z-index: 1;
    padding: 80rpx;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    gap: 50rpx;
    min-height: 100rpx;
}

/* 头像容器 */
.avatar-container {
    display: flex;
    align-items: center;
    /* 确保按钮在容器内垂直居中 */
    justify-content: center;
    /* 与昵称的间距 */
    border-radius: 21vw;
    width: 20vw;
    height: 20vw;
    border: 3px lightgrey solid;
}

/* 头像区域 */
.avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    /* border: 3rpx lightblue solid; */
}

/* 头像按钮 */
.avatar-section t-button {
    margin: 0 auto;
}

/* 头像骨架屏 */
.avatar-skeleton {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    margin: 0 auto;
}

/* 实际头像 */
.avatar-image {
    width: 160rpx;
    height: 160rpx;
    border-radius: 50%;
    border: 3rpx solid lightblue;
}

/* 昵称区域 */
.nickname-section {
    position: relative;
    min-height: 100rpx;
}

/* 昵称输入框 */
.nickname-input {
    width: 100%;
    height: 80rpx;
    padding: 0 24rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    font-size: 32rpx;
    box-sizing: border-box;
}

/* 昵称骨架屏 */
.nickname-skeleton {
    width: 100%;
    height: 80rpx;
    border-radius: 12rpx;
}

/* 添加过渡动画 */
.avatar-skeleton,
.nickname-skeleton,
.avatar-image,
.nickname-input {
    transition: opacity 0.3s ease;
}